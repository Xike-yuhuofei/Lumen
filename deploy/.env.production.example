# ============================================================
# Lumen 2.0.0 — Production Deployment Environment Template
# ============================================================
# Copy to `<deploy-root>/.env.production` and fill in the values.
# `.env.production` must NEVER be committed to git (it is gitignored).
#
# Provider API keys are read ONLY from the process environment
# (lumen/shared/config/credentials.py). Convention: <BINDING>_API_KEY.
# Never write plaintext keys into config files, source, or artifacts.
#
# LUMEN_HOME is the runtime workspace root; all runtime data lives under
# <LUMEN_HOME>/data (settings, SQLite, knowledge bases, memory, logs).
# ============================================================

# ---- Runtime home (workspace root; owns data/user, logs, telemetry) ----
LUMEN_HOME=/srv/lumen/data

# ---- Server binding (used by the systemd/launchd unit) ----
LUMEN_BIND_HOST=127.0.0.1
LUMEN_BIND_PORT=8001

# ---- LLM Provider credentials (real production values here) ----
# At least one provider key is required for turns to succeed.
# Lumen fails fast (no silent fallback) when the active provider has no key.
DEEPSEEK_API_KEY=
ZHIPU_API_KEY=
GITEE_API_KEY=
OPENAI_API_KEY=
CODEXMANAGER_API_KEY=

# ---- Agent Loop Provider ----
# Production default is P1 agent_loop.langgraph_thin (set by PRODUCTION_PROFILE).
# Unset to keep the production default. Rollback to Legacy P0:
# LUMEN_AGENT_LOOP_PROVIDER=legacy

# ---- Observability / Telemetry ----
# Local-first: span telemetry is always written to <LUMEN_HOME>/data/user/logs/telemetry.
# External export is OPTIONAL. Enable OTLP (Phoenix / Collector) by listing:
# LUMEN_TELEMETRY_EXPORTERS=otlp
# Phoenix / OTLP Collector OTLP/HTTP endpoint (protobuf required by Phoenix):
# LUMEN_OTEL_ENDPOINT=http://127.0.0.1:6006/v1/traces
# LUMEN_OTEL_ENCODING=protobuf
# LUMEN_OTEL_BATCH_SIZE=64
# LUMEN_TELEMETRY_EXPORT_TIMEOUT_SECONDS=3.0
# Optional metrics summary (local JSONL):
# LUMEN_TELEMETRY_EXPORTERS=otlp,metrics_summary
# LUMEN_METRICS_SUMMARY_DIR=/srv/lumen/data/user/logs/metrics
# LUMEN_TELEMETRY_SAMPLING_RATIO=1.0

# ---- Auth (optional multi-user; off by default = single-user) ----
# AUTH_ENABLED=true
# CORS_ORIGINS=https://app.example.com

# ---- Sandbox (model-generated code execution) ----
# Default enabled (sandbox_allow_subprocess). Disable for hardened hosts:
# LUMEN_SANDBOX_ALLOW_SUBPROCESS=0
